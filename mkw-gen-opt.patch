+    raise SystemExit(f"MKW_GEN_OPT={GEN_OPT!r}: use 1, 2, 3 or s")
+GEN_FLAGS = [f"-O{GEN_OPT}", "-fno-strict-aliasing", "-Wno-return-type", "-Wno-unused-label", "-fvisibility=hidden",
              *ARCH_FLAGS[ARCH], *GEN_ARCH_FLAGS[ARCH]]  # fmt: skip
