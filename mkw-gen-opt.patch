+# Optimization level of the generated game code (MKW_GEN_OPT: 1, 2, 3 or s; default 1, as always). It is part of
+# game_id(): the runtime and mkwgame.so/.dll must be built with the same value, or the runtime will not load the library.
+GEN_OPT = os.environ.get("MKW_GEN_OPT", "1")
